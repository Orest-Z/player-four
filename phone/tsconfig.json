{
  // Strict TypeScript checking for the plain JavaScript here (JSDoc types + // @ts-check).
  // Nothing is compiled: browsers run these files exactly as they are.
  // Check: npx -p typescript@5 tsc -p phone   (tests/run.mjs does it first)
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "skipLibCheck": true
  },
  "include": ["src"]
}
